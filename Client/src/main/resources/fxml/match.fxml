<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx"
            fx:controller="org.hsw.display.controller.MatchController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <top>
        <BorderPane>
            <center>
                <VBox alignment="CENTER" spacing="10">
                    <Label text="Ergebnis der letzten Runde:"/>
                    <HBox alignment="CENTER" spacing="40">
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="War die Antwort korrekt?"/>
                            <Label fx:id="lastAnswerCorrectLabel" text="–"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="Punkte"/>
                            <Label fx:id="lastPointsLabel" text="–"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="Richtige Antwort"/>
                            <Label fx:id="lastCorrectAnswerLabel" text="–"/>
                        </VBox>
                    </HBox>
                </VBox>
            </center>
            <right>
                <VBox alignment="TOP_RIGHT" spacing="10">
                    <Label text="Rundennummer:"/>
                    <Label fx:id="currentRoundNumberLabel" text="-"/>
                </VBox>
            </right>
        </BorderPane>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label fx:id="timerLabel" text="30">
                <font>
                    <Font size="48.0"/>
                </font>
            </Label>
            <Label fx:id="questionLabel" text="Question" wrapText="true"/>
            <VBox fx:id="answerContainer" alignment="CENTER" spacing="10"/>
        </VBox>
    </center>
    <bottom>
        <VBox alignment="BOTTOM_LEFT" spacing="20">
            <Button text="Match verlassen" onAction="#leaveMatch"/>
        </VBox>
    </bottom>
</BorderPane>
